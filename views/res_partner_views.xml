<odoo>
    <record id="view_partner_form_extended_profile" model="ir.ui.view">
        <field name="name">res.partner.form.extended.profile</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Personal Details" name="personal_details" invisible="is_company">
                    <group>
                        <group string="Personal">
                            <field name="birth_date"/>
                            <field name="gender"/>
                            <field name="marital_status"/>
                        </group>
                        <group string="Additional Contact / Employment">
                            <field name="mobile2" widget="phone"/>
                            <field name="phone_work" widget="phone"/>
                            <field name="employer"/>
                        </group>
                    </group>
                    <separator string="Identification" groups="base.group_system"/>
                    <field name="identity_document_ids" context="{'default_partner_id': id}" groups="base.group_system">
                        <list editable="bottom">
                            <field name="identity_type_id"/>
                            <field name="number"/>
                            <field name="document_copy" filename="document_filename"/>
                            <field name="document_filename" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
